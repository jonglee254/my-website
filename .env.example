# Server
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
# Multi-region or local pool
DATABASE_URL=postgresql://postgres:antigravity_secret_password@localhost:5432/antigravity_portal?schema=public

# Cache & Locks (Redis)
REDIS_URL=redis://localhost:6379

# Crypto Gateway (e.g. Fireblocks, BitGo, Circle, Coinbase Commerce)
CRYPTO_GATEWAY_API_KEY=your_crypto_api_key_here
CRYPTO_WEBHOOK_SECRET=your_crypto_hmac_secret_here

# Skrill Merchant Settings
SKRILL_MERCHANT_EMAIL=payments@antigravityportal.org
SKRILL_SECRET_WORD=your_skrill_secret_word_here
SKRILL_MQI_PASSWORD=your_skrill_mqi_password_here

# Neteller Merchant Settings
NETELLER_CLIENT_ID=your_neteller_client_id_here
NETELLER_CLIENT_SECRET=your_neteller_client_secret_here

# Webhook URLs (Your public domain)
APP_BASE_URL=https://api.antigravityportal.org

# Security & Access Control
ADMIN_API_KEY=your_secure_admin_api_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret_here
ALLOWED_ORIGINS=http://localhost:3000,https://spermdonorsportal.org
