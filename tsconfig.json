{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@libs/shared-types": ["libs/shared-types/index.ts"],
      "@libs/region-utils": ["libs/region-utils/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
